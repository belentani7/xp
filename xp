def cmd_combat(args):
    """Manual combat — fight a bug."""
    player = get_player()
    if not player:
        print(f"{C.RED}No character found.{C.RESET}")
        return

    bug_name = " ".join(args) if args else "Mysterious Bug"

    import random
    severity = random.choice(["trivial", "minor", "moderate", "major", "critical"])
    hp_map = {"trivial": 20, "minor": 40, "moderate": 80, "major": 150, "critical": 300}
    xp_map = {"trivial": 10, "minor": 25, "moderate": 50, "major": 100, "critical": 200}

    bug_hp = hp_map[severity]
    bug_xp = xp_map[severity]

    print(f"\n{C.BOLD}{C.RED}{'═' * 50}")
    print(f"  ⚔️  COMBAT: {bug_name}")
    print(f"  Severity: {severity.upper()}")
    print(f"{'═' * 50}{C.RESET}\n")

    # Simulate combat
    player_str = player.get("stats", {}).get("STR", 5)
    player_int = player.get("stats", {}).get("INT", 5)
    player_dex = player.get("stats", {}).get("DEX", 5)

    import time
    damage = 0
    turns = 0
    while bug_hp > 0 and turns < 10:
        turns += 1
        hit = random.randint(1, player_str + player_int) + player_dex // 2
        crit = random.random() < 0.15
        if crit:
            hit *= 2
        bug_hp -= hit
        damage += hit
        crit_text = f" {C.NEON_YELLOW}CRITICAL!{C.RESET}" if crit else ""
        print(f"  Turn {turns}: You deal {C.RED}{hit}{C.RESET} damage!{crit_text} (Bug HP: {max(0, bug_hp)})")
        if bug_hp > 0:
            time.sleep(0.3)

    if bug_hp <= 0:
        print(f"\n  {C.NEON_GREEN}🏆 VICTORY! {bug_name} defeated!{C.RESET}")
        print(f"  {C.YELLOW}+{bug_xp} XP{C.RESET}")
        result = award_xp("bugfix", f"Defeated: {bug_name}")
        if result["leveled_up"]:
            print(f"\n  {C.NEON_YELLOW}⬆️  LEVEL UP! You are now level {result['new_level']}!{C.RESET}")
    else:
        print(f"\n  {C.RED}💀 The bug escaped. Try again later.{C.RESET}")

    print(f"\n{C.RED}{'═' * 50}{C.RESET}\n")


