def bar(current, maximum, length=20, fill_char="█", empty_char="░", color=C.GREEN):
    """Render a progress bar."""
    if maximum <= 0:
        return f"{empty_char * length}"
    filled = min(length, int(length * current / maximum))
    return f"{color}{fill_char * filled}{C.DIM}{empty_char * (length - filled)}{C.RESET}"


def cmd_status():
    """Show character sheet."""
    player = get_player()
    if not player:
        print(f"{C.RED}No character found. Run 'install.sh' first.{C.RESET}")
        return

    p = player
    level = p["level"]
    xp = p["xp"]
    next_xp = xp_for_next_level(level)
    current_level_xp = xp_for_level(level)
    xp_in_level = xp - current_level_xp
    xp_needed = next_xp

    class_name = p.get("class") or "Unchosen"
    class_icon = "❓"
    if class_name != "Unchosen" and class_name in CLASSES:
        class_icon = CLASSES[class_name]["icon"]

    print(f"\n{C.BOLD}{C.NEON_CYAN}{'═' * 50}")
    print(f"  {C.NEON_YELLOW}⚔️  CHARACTER SHEET ⚔️{C.NEON_CYAN}")
    print(f"{'═' * 50}{C.RESET}\n")

    print(f"  {C.BOLD}Name:{C.RESET}    {p['name']}")
    print(f"  {C.BOLD}Class:{C.RESET}   {class_icon} {class_name.title()}")
    print(f"  {C.BOLD}Level:{C.RESET}   {C.NEON_YELLOW}{level}{C.RESET}")
    print()

    # HP Bar
    hp = p.get("hp", 100)
    max_hp = p.get("max_hp", 100)
    print(f"  {C.RED}HP:{C.RESET}  {bar(hp, max_hp, color=C.RED)}  {hp}/{max_hp}")

    # MP Bar
    mp = p.get("mp", 50)
    max_mp = p.get("max_mp", 50)
    print(f"  {C.BLUE}MP:{C.RESET}  {bar(mp, max_mp, color=C.BLUE)}  {mp}/{max_mp}")

    # XP Bar
    print(f"  {C.YELLOW}XP:{C.RESET}  {bar(xp_in_level, xp_needed, color=C.YELLOW)}  {xp_in_level}/{xp_needed}")
    print(f"       {C.DIM}(Total: {xp:,} XP){C.RESET}")
    print()

    # Stats
    stats = p.get("stats", {})
    if stats:
        print(f"  {C.BOLD}{'─' * 30}")
        print(f"  {C.BOLD}STATS{C.RESET}")
        print(f"  {'─' * 30}")
        stat_icons = {"STR": "💪", "INT": "🧠", "DEX": "⚡", "WIS": "📖", "CHA": "💬"}
        for stat, val in stats.items():
            icon = stat_icons.get(stat, "•")
            base_val = p.get("base_stats", {}).get(stat, val)
            bonus = val - base_val
            bonus_str = f" {C.GREEN}(+{bonus}){C.RESET}" if bonus > 0 else ""
            print(f"  {icon} {stat}: {C.BOLD}{val}{C.RESET}{bonus_str}")
        print()

    # Equipment
    equipped = p.get("equipped", [])
    if equipped:
        print(f"  {C.BOLD}{'─' * 30}")
        print(f"  {C.BOLD}EQUIPMENT{C.RESET}")
        print(f"  {'─' * 30}")
        for item_id in equipped:
            try:
                print(f"  {get_item_display(item_id)}")
            except ValueError:
                print(f"  {C.DIM}  {item_id}{C.RESET}")
        print()

    # Streak
    streak = p.get("streak", {})
    if streak:
        current = streak.get("current_streak", 0)
        longest = streak.get("longest_streak", 0)
        fire = "🔥" * min(current, 7) if current > 0 else ""
        print(f"  {C.BOLD}Streak:{C.RESET} {C.NEON_YELLOW}{current}{C.RESET} days {fire}")
        print(f"  {C.BOLD}Best:{C.RESET}   {longest} days")
        print()

    print(f"{C.NEON_CYAN}{'═' * 50}{C.RESET}\n")


def cmd_quest():
    """Show current quests."""
    player = get_player()
    if not player:
        print(f"{C.RED}No character found.{C.RESET}")
        return

    print(f"\n{C.BOLD}{C.NEON_MAGENTA}{'═' * 50}")
    print(f"  📜 QUEST LOG")
    print(f"{'═' * 50}{C.RESET}\n")

    quests = list_quests_by_category()
    for category in QUEST_CATEGORIES:
        cat_quests = quests.get(category, [])
        if not cat_quests:
            continue
        cat_label = category.upper()
        print(f"  {C.BOLD}{C.NEON_YELLOW}── {cat_label} ──{C.RESET}")
        for q in cat_quests:
            # Estimate progress from player stats
            progress = 0
            at = q.get("action_type", "")
            if at == "commit":
                progress = get_commit_count()
            elif at in ("bugfix", "feature", "refactor", "test", "documentation", "hotfix", "review", "deploy"):
                progress = get_action_count(at)
            elif at == "streak":
                streak = player.get("streak", {})
                progress = streak.get("current_streak", 0)
            elif at == "pr_merge":
                progress = get_action_count("pr_merge")
            elif at == "any":
                # Count unique action types
                for action in ["commit", "bugfix", "feature", "refactor", "test", "documentation"]:
                    if get_action_count(action) > 0:
                        progress += 1

            status = "✅" if progress >= q["target"] else "🔲"
            pct = min(100, int((progress / q["target"]) * 100)) if q["target"] > 0 else 0
            prog_bar = bar(min(progress, q["target"]), q["target"], length=10, color=C.NEON_GREEN if progress >= q["target"] else C.YELLOW)

            print(f"  {status} {q['icon']} {C.BOLD}{q['name']}{C.RESET}")
            print(f"     {C.DIM}{q['description']}{C.RESET}")
            print(f"     {prog_bar} {progress}/{q['target']} ({C.YELLOW}+{q['xp_reward']} XP{C.RESET})")
            print()

    print(f"{C.NEON_MAGENTA}{'═' * 50}{C.RESET}\n")


def cmd_achievements():
    """List achievements."""
    player = get_player()
    if not player:
        print(f"{C.RED}No character found.{C.RESET}")
        return

    unlocked = {a["achievement_id"] for a in get_achievements()}
    total = len(ACHIEVEMENTS)
    count = len(unlocked)

    print(f"\n{C.BOLD}{C.NEON_YELLOW}{'═' * 50}")
    print(f"  🏆 ACHIEVEMENTS ({count}/{total})")
    print(f"{'═' * 50}{C.RESET}\n")

    by_cat = list_achievements_by_category()
    for category in ACH_CATEGORIES:
        cat_achs = by_cat.get(category, [])
        if not cat_achs:
            continue
        cat_label = category.upper()
        cat_unlocked = sum(1 for a in cat_achs if a["id"] in unlocked)
        print(f"  {C.BOLD}── {cat_label} ({cat_unlocked}/{len(cat_achs)}) ──{C.RESET}")
        for ach in cat_achs:
            is_unlocked = ach["id"] in unlocked
            if is_unlocked:
                print(f"  ✅ {ach['icon']} {C.BOLD}{ach['name']}{C.RESET} — {ach['description']} ({C.YELLOW}+{ach['xp_reward']} XP{C.RESET})")
            else:
                print(f"  {C.DIM}🔒 {ach['icon']} {ach['name']} — ???{C.RESET}")
        print()

    print(f"{C.NEON_YELLOW}{'═' * 50}{C.RESET}\n")


def cmd_equip(args):
    """Equip an item."""
    if not args:
        cmd_items()
        return

    item_id = args[0].lower()
    if item_id == "--off" and len(args) > 1:
        unequip_item(args[1].lower())
        print(f"{C.GREEN}Unequipped {args[1]}.{C.RESET}")
        return

    try:
        equip_item(item_id)
        item = get_item(item_id)
        print(f"{C.GREEN}{item['icon']} Equipped {item['name']}!{C.RESET}")
        stats_str = ", ".join(f"{k}+{v}" if v > 0 else f"{k}{v}" for k, v in item["stats"].items())
        print(f"  {C.DIM}{stats_str}{C.RESET}")
        print(f"  {C.DIM}\"{item['flavor']}\"{C.RESET}")
    except ValueError as e:
        print(f"{C.RED}{e}{C.RESET}")


