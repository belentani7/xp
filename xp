def main():
    """Main CLI entry point."""
    # Ensure database exists
    if not DB_PATH.exists():
        init_database()
        create_player()

    args = sys.argv[1:]
    if not args:
        cmd_status()
        return

    command = args[0].lower()
    rest = args[1:]

    commands = {
        "status": lambda: cmd_status(),
        "s": lambda: cmd_status(),
        "quest": lambda: cmd_quest(),
        "q": lambda: cmd_quest(),
        "quests": lambda: cmd_quest(),
        "achievements": lambda: cmd_achievements(),
        "ach": lambda: cmd_achievements(),
        "equip": lambda: cmd_equip(rest),
        "items": lambda: cmd_items(),
        "class": lambda: cmd_class(rest),
        "log": lambda: cmd_log(rest),
        "streak": lambda: cmd_streak(),
        "leaderboard": lambda: cmd_leaderboard(),
        "lb": lambda: cmd_leaderboard(),
        "lore": lambda: cmd_lore(),
        "combat": lambda: cmd_combat(rest),
        "fight": lambda: cmd_combat(rest),
        "help": lambda: cmd_help(),
        "--help": lambda: cmd_help(),
        "-h": lambda: cmd_help(),
    }

    handler = commands.get(command)
    if handler:
        handler()
    else:
        print(f"{C.RED}Unknown command: {command}{C.RESET}")
        print(f"Run {C.NEON_CYAN}xp help{C.RESET} for available commands.")


if __name__ == "__main__":
    main()
