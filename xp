def cmd_log(args=None):
    """Show recent XP gains."""
    limit = 20
    if args and args[0].isdigit():
        limit = int(args[0])

    logs = get_xp_log(limit)
    print(f"\n{C.BOLD}{C.NEON_GREEN}{'═' * 50}")
    print(f"  📊 XP LOG (last {limit})")
    print(f"{'═' * 50}{C.RESET}\n")

    if not logs:
        print(f"  {C.DIM}No XP entries yet. Start coding!{C.RESET}\n")
        return

    for entry in logs:
        amount = entry["amount"]
        color = C.GREEN if amount > 0 else C.RED
        sign = "+" if amount > 0 else ""
        ts = entry["timestamp"][:16].replace("T", " ")
        print(f"  {C.DIM}{ts}{C.RESET}  {color}{sign}{amount} XP{C.RESET}  {entry['reason']}")

    total = sum(e["amount"] for e in logs)
    print(f"\n  {C.BOLD}Shown total: {C.YELLOW}{total:+,} XP{C.RESET}")
    print(f"{C.NEON_GREEN}{'═' * 50}{C.RESET}\n")


def cmd_streak():
    """Show coding streak."""
    player = get_player()
    if not player:
        print(f"{C.RED}No character found.{C.RESET}")
        return

    streak = player.get("streak", {})
    current = streak.get("current_streak", 0)
    longest = streak.get("longest_streak", 0)

    print(f"\n{C.BOLD}{C.NEON_YELLOW}{'═' * 50}")
    print(f"  🔥 CODING STREAK")
    print(f"{'═' * 50}{C.RESET}\n")

    fire = "🔥" * min(current, 10) if current > 0 else "❄️"
    print(f"  {C.BOLD}Current:{C.RESET} {C.NEON_YELLOW}{current}{C.RESET} days {fire}")
    print(f"  {C.BOLD}Best:{C.RESET}    {longest} days")

    # Visual streak calendar (last 7 days)
    print(f"\n  {C.BOLD}Last 7 days:{C.RESET}")
    from datetime import timedelta
    today = datetime.now().date()
    last_commit = streak.get("last_commit_date")
    for i in range(6, -1, -1):
        day = today - timedelta(days=i)
        label = day.strftime("%a %m/%d")
        is_today = (i == 0)
        # Simple: only today is guaranteed active
        if is_today and last_commit == today.isoformat():
            print(f"    {label}  {C.GREEN}███ COMMIT{C.RESET}")
        elif is_today:
            print(f"    {label}  {C.DIM}░░░ waiting{C.RESET}")
        else:
            print(f"    {label}  {C.DIM}░░░{C.RESET}")

    if current >= 7:
        print(f"\n  {C.NEON_YELLOW}🔥 On fire! Keep it going!{C.RESET}")
    elif current >= 3:
        print(f"\n  {C.YELLOW}Good momentum. Don't break the chain!{C.RESET}")
    elif current > 0:
        print(f"\n  {C.DIM}Building up. Consistency is key.{C.RESET}")
    else:
        print(f"\n  {C.DIM}Start coding today to begin a streak!{C.RESET}")

    print(f"\n{C.NEON_YELLOW}{'═' * 50}{C.RESET}\n")


def cmd_leaderboard():
    """Show leaderboard (local or shared)."""
    player = get_player()

    print(f"\n{C.BOLD}{C.NEON_CYAN}{'═' * 50}")
    print(f"  🏆 LEADERBOARD")
    print(f"{'═' * 50}{C.RESET}\n")

    # Read shared leaderboard if exists
    leaderboard_path = DB_PATH.parent / "leaderboard.json"
    entries = []
    if leaderboard_path.exists():
        try:
            entries = json.loads(leaderboard_path.read_text())
        except (json.JSONDecodeError, OSError):
            pass

    # Add current player
    if player:
        entries.append({
            "name": player["name"],
            "level": player["level"],
            "xp": player["xp"],
            "class": player.get("class", "unchosen"),
            "streak": player.get("streak", {}).get("current_streak", 0),
        })

    # Sort by XP
    entries.sort(key=lambda e: e.get("xp", 0), reverse=True)

    if not entries:
        print(f"  {C.DIM}No entries yet. Be the first!{C.RESET}\n")
        return

    medals = ["🥇", "🥈", "🥉"]
    for i, entry in enumerate(entries[:20]):
        rank = medals[i] if i < 3 else f"#{i+1:>2}"
        name = entry.get("name", "Unknown")
        level = entry.get("level", 1)
        xp = entry.get("xp", 0)
        cls = entry.get("class", "unchosen")
        streak = entry.get("streak", 0)
        streak_str = f" 🔥{streak}" if streak > 0 else ""

        is_you = player and name == player["name"] and level == player["level"]
        highlight = C.NEON_YELLOW if is_you else ""
        reset = C.RESET if is_you else ""

        print(f"  {rank} {highlight}{name}{reset}  Lv.{level}  {xp:,} XP  [{cls}]{streak_str}")

    print(f"\n  {C.DIM}Share your stats: copy ~/.xp/leaderboard.json{C.RESET}")
    print(f"{C.NEON_CYAN}{'═' * 50}{C.RESET}\n")


